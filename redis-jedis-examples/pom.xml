<?xml version="1.0" encoding="UTF-8"?>
<!--
  Module 1: core Redis data types using the Jedis client.

  Run the examples:  mvn -pl redis-jedis-examples exec:java
  Run the tests:     mvn -pl redis-jedis-examples test
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.practice.redis</groupId>
        <artifactId>redis-practice</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>redis-jedis-examples</artifactId>
    <name>redis-jedis-examples</name>
    <description>Strings, lists, hashes, sets, sorted sets and pub/sub with Jedis</description>

    <!-- No <version> tags: the parent POM manages them -->
    <dependencies>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.practice.redis.jedis.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
